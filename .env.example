DATABASE_URL=mysql://user:password@localhost:3306/portfolio
ADMIN_PASSWORD=
SESSION_SECRET=

# Server-side Cloudinary credentials (never prefix these with NEXT_PUBLIC_).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portfolio/images
# New accounts normally use dynamic folders; use fixed for legacy folder mode.
CLOUDINARY_FOLDER_MODE=dynamic
